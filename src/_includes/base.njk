<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title %}{{ title }} · {% endif %}{{ meta.name }}</title>
<meta name="description" content="{{ description or summary or site.tagline }}">
{% if meta.sample %}<meta name="robots" content="noindex">{% endif %}
<meta name="theme-color" content="#141818">
<link rel="icon" href="/brand/f-q.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,600..900,100,1&family=Urbanist:wght@400;500;700;800;900{% if home %}&family=Caveat:wght@600;700{% endif %}&display=swap">
<link rel="stylesheet" href="/assets/site.css">
{% if home %}<link rel="stylesheet" href="/assets/home.css">
<link rel="stylesheet" href="/assets/vendor/lenis.css">{% endif %}
<script>
  // Runs before the first paint. Marks that JavaScript is on, and if we got here
  // through the stripe wipe, starts the page covered so the wipe can lift off it.
  (function (c) {
    c.add("js");
    try { if (sessionStorage.getItem("lssq-wipe")) { sessionStorage.removeItem("lssq-wipe"); c.add("wipe-in"); } } catch (e) {}
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) c.add("motion");
  })(document.documentElement.classList);
</script>
<script type="speculationrules">{ "prefetch": [{ "source": "document", "eagerness": "moderate" }] }</script>
</head>
<body{% if home %} class="home"{% endif %}>
{# The page transition: three stripes and then ink sweep up as wide arcs, like the logo's ribbon. #}
<div class="wipe" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
<a class="skip" href="#main">Skip to content</a>
{% if meta.sample %}
<p class="sample-bar">A sample build, not LSSQ's official site. Upcoming events are made up, and some photos are stock. <a href="{{ meta.official }}">Visit the real site</a></p>
{% endif %}
<header class="top">
  <div class="wrap top-inner">
    <a class="logo" href="/"><img src="/brand/f-stripes.svg" width="418" height="134" alt="Last Saturday Side Quest, home"></a>
    <nav aria-label="Main">
      <ul class="nav">
        <li><a href="/events/"{% if page.url.startsWith("/events/") %} aria-current="page"{% endif %}>Events</a></li>
        <li><a href="/story/"{% if page.url == "/story/" %} aria-current="page"{% endif %}>Our story</a></li>
        <li><a href="/contact/"{% if page.url == "/contact/" %} aria-current="page"{% endif %}>Contact</a></li>
      </ul>
    </nav>
    <a class="btn small" href="/#donate">Donate</a>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="foot">
  <div class="wrap foot-inner">
    <img class="foot-q" src="/brand/f-q.svg" width="56" height="56" alt="">
    <div class="foot-text">
      <p class="foot-tag">{{ site.tagline }}</p>
      <ul class="foot-links">
        <li><a href="/events/">Events</a></li>
        <li><a href="/story/">Our story</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="{{ site.contact.instagram }}">Instagram</a></li>
        <li><a href="/#donate">Donate</a></li>
      </ul>
    </div>
    {% if meta.sample %}
    <p class="foot-note">A sample build by Steve Gordon, from the <a href="{{ meta.workshop }}">LSSQ Workshop</a>. Not LSSQ's official site, which is at <a href="{{ meta.official }}">lastsaturdaysidequest.odoo.com</a>.</p>
    {% endif %}
  </div>
</footer>
<script src="/assets/site.js" defer></script>
{% if home %}
<script src="/assets/vendor/gsap.min.js" defer></script>
<script src="/assets/vendor/ScrollTrigger.min.js" defer></script>
<script src="/assets/vendor/lenis.min.js" defer></script>
<script src="/assets/home.js" defer></script>
{% endif %}
</body>
</html>
