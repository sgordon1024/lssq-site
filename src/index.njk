---
layout: base.njk
home: true
---
{#- The homepage is one long scroll through scenes: the hero collage, the tagline
    riding the ribbon, the four pillars sliding sideways, the road so far, the next
    weekend and the donate band. Every scene reads fine without JavaScript or with
    reduced motion; home.js only adds the movement. -#}
{% set next = collections.upcoming[0] %}
{% set tilts = [-7, 5, -4, 8, -6, 4] %}
{% set speeds = [-0.35, 0.25, 0.4, -0.2] %}
{% set stickerSpeeds = [0.6, -0.45] %}

<section class="h-hero" aria-labelledby="hero-title">
  <div class="h-stage echo-host">
    <p class="label" data-enter>{{ site.hero.label }}</p>
    <h1 id="hero-title" class="h-title echo" data-text="{{ site.hero.headline }}">{% for w in site.hero.headline.split(" ") %}<span class="w"><span>{{ w }}</span></span> {% endfor %}</h1>
    <p class="lede" data-enter>{{ site.hero.text }}</p>
    <div class="actions" data-enter>
      <a class="btn primary" href="{{ next.url if next else '/events/' }}">{{ "See what's next" if next else "See all events" }}</a>
      <a class="btn" href="/story/">Our story</a>
    </div>
  </div>

  {# The collage. Photos from past weekends, taped down like prints, plus stickers. #}
  <div class="h-collage">
    {% for g in site.gallery | head(4) %}
    <figure class="print hp{{ loop.index }}" style="--r: {{ tilts[loop.index0] }}deg" data-speed="{{ speeds[loop.index0] }}" data-toss>
      <img src="{{ g.photo }}" alt="{{ g.alt }}">
      {% if g.credit %}<figcaption>{{ g.credit }}</figcaption>{% endif %}
    </figure>
    {% endfor %}
    <span class="sticker sq" data-speed="0.5" data-pop aria-hidden="true"><img src="/brand/f-q.svg" alt=""></span>
    {% set c = ["var(--cyan)", "var(--sun)", "var(--pink)", "var(--lav)"] %}
    {% for pillar in site.about.pillars | head(2) %}
    <span class="sticker sp{{ loop.index }}" style="--c: {{ c[loop.index0 * 2] }}" data-speed="{{ stickerSpeeds[loop.index0] }}" data-pop aria-hidden="true">{% sticker pillar.icon %}</span>
    {% endfor %}
    {% if next %}
    <a class="next-badge" href="{{ next.url }}" data-speed="-0.15" data-pop><span class="nb-face">
      <small>Next up</small>
      <b>{{ next.data.title }}</b>
      <span>{{ next.data.start | dates(next.data.end) }}</span>
      <span class="nb-count" data-countdown="pill" data-start="{{ next.data | startsAt }}" data-end="{{ next.data | endsAt }}">{% set days = next.data.start | daysUntil %}{% if days > 1 %}<b>{{ days }}</b> days to go{% elif days == 1 %}<b>Tomorrow</b>{% else %}<b>Happening now</b>{% endif %}</span>
    </span></a>
    {% if site.hero.note %}
    <p class="hand h-note" data-enter>{{ site.hero.note }}<svg viewBox="0 0 120 70" aria-hidden="true"><path d="M6 8c30 2 62 14 82 44" /><path d="M74 50l15 4 3-16" /></svg></p>
    {% endif %}
    {% endif %}
  </div>
</section>

{# Short, useful lines ride along the ribbon, starting with the next weekend. Hidden from
   screen readers because it moves; the same facts are on this page and the event pages. #}
<div class="h-ribbon" aria-hidden="true">
  <svg viewBox="0 0 1600 260" preserveAspectRatio="xMidYMid slice">
    <path class="rb-cyan" d="{{ 60 | ribbonPath }}" />
    <path id="rb-line" class="rb-band" d="{{ 0 | ribbonPath }}" />
    <path class="rb-pink" d="{{ -60 | ribbonPath }}" />
    <text class="rb-text" dy="14" data-reps="2"><textPath href="#rb-line" startOffset="0">{% for i in range(2) %}{% if next %}{{ ("Next up: " + next.data.title + ", " + (next.data.start | dates(next.data.end))) | upper }}<tspan class="rb-star"> ✦ </tspan>{% endif %}{% for t in site.ribbon %}{{ t | upper }}<tspan class="rb-star"> ✦ </tspan>{% endfor %}{% endfor %}</textPath></text>
  </svg>
</div>

<section class="h-pillars" id="about" aria-labelledby="about-title">
  <div class="hp-track">
    <div class="hp-panel hp-intro">
      <div class="hp-intro-text">
        <p class="label">What is LSSQ</p>
        <h2 id="about-title">{{ site.about.headline }}</h2>
        <p>{{ site.about.text }}</p>
        <a class="more-link" href="/story/">Read our story <span aria-hidden="true">→</span></a>
      </div>
      <p class="hand hp-hint" aria-hidden="true">four things hold it together<svg viewBox="0 0 120 40"><path d="M4 20h104" /><path d="M96 9l13 11-13 11" /></svg></p>
    </div>
    {#- Each pillar is a scrapbook page: the word, what you'll find, three taped photos,
        four stickers and a handwritten note. -#}
    {% set colors = ["var(--cyan)", "var(--sun)", "var(--pink)", "var(--lav)"] %}
    {% set accents = ["var(--pink)", "var(--cyan)", "var(--sun)", "var(--sun)"] %}
    {% set printTilts = [5, -6, -3] %}
    {% set printDepth = [1, 1.4, 0.7] %}
    {% set stickerDepth = [1, -1.2, 1.5, -0.8] %}
    {% for pillar in site.about.pillars %}
    <article class="hp-panel hp-pillar" style="--c: {{ colors[loop.index0 % 4] }}; --c2: {{ accents[loop.index0 % 4] }}; --len: {{ pillar.name | length }}" aria-labelledby="pillar-{{ loop.index }}">
      <div class="hp-core">
        <h3 class="hp-word" id="pillar-{{ loop.index }}">{{ pillar.name }}</h3>
        {% if pillar.things and pillar.things.length %}
        <ul class="hp-things" aria-label="{{ pillar.name }} at LSSQ">{% for t in pillar.things %}<li>{{ t }}</li>{% endfor %}</ul>
        {% endif %}
        <p class="hp-text">{{ pillar.text }}</p>
      </div>
      <div class="hp-art">
        {% for p in pillar.photos | head(3) %}
        <figure class="print hp-print hp-print-{{ loop.index }}" style="--r: {{ printTilts[loop.index0] }}deg" data-depth="{{ printDepth[loop.index0] }}">
          <img src="{{ p.photo }}" alt="{{ p.alt }}" loading="lazy">
          {% if p.credit %}<figcaption>{{ p.credit }}</figcaption>{% endif %}
        </figure>
        {% endfor %}
        {% for st in pillar.stickers | head(4) %}
        <span class="hp-sticker hp-sticker-{{ loop.index }}" aria-hidden="true" data-depth="{{ stickerDepth[loop.index0] }}">{% sticker st %}</span>
        {% endfor %}
      </div>
      {% if pillar.note %}<p class="hand hp-note" aria-hidden="true">{{ pillar.note }}</p>{% endif %}
    </article>
    {% endfor %}
  </div>
</section>

{% if collections.past.length %}
<section class="h-past" aria-labelledby="past-title">
  <div class="wrap">
    <div class="h-past-head">
      <p class="label">Where we've been</p>
      <h2 id="past-title">Every stop on the road.</h2>
      <p class="hand" aria-hidden="true">the photo wall so far</p>
    </div>
    <ul class="h-pile">
      {% for e in collections.past | head(6) %}
      <li style="--r: {{ tilts[(loop.index0 + 2) % 6] }}deg" data-fly>
        <a href="{{ e.url }}" class="print h-stop">
          {% if e.data.photo %}<img src="{{ e.data.photo }}" alt="" loading="lazy">{% endif %}
          <span class="hand">{{ e.data.title }}</span>
          <small>{{ e.data.start | monthYear }} · {{ e.data.place }}</small>
        </a>
      </li>
      {% endfor %}
    </ul>
    <p class="more"><a href="/events/">Every event <span aria-hidden="true">→</span></a></p>
  </div>
</section>
{% endif %}

<section class="h-next echo-host" id="next" aria-labelledby="next-title">
  {% if next %}
  {% set d = next.data %}
  {% set days = d.start | daysUntil %}
  <div class="wrap h-next-head">
    <p class="label sun">Next up · {{ d.start | dates(d.end) }}{% if d.sample %} · <span class="tag">Sample</span>{% endif %}</p>
    <h2 class="echo" id="next-title" data-text="{{ d.title }}"><a href="{{ next.url }}">{{ d.title }}</a></h2>
  </div>
  <figure class="h-next-photo{% if not d.photo %} no-photo{% endif %}" data-grow>
    {% if d.photo %}<img src="{{ d.photo }}" alt="{{ d.photoAlt }}" loading="lazy">{% endif %}
    <div class="countdown" data-countdown="full" data-start="{{ d | startsAt }}" data-end="{{ d | endsAt }}">
      <p class="cd-label">{{ "Starts in" if days > 0 else "Happening now" }}</p>
      <p class="cd-units"{% if days <= 0 %} hidden{% endif %}>
        <span class="cd-unit"><b data-unit="d">{{ days }}</b><small>days</small></span>
        <span class="cd-unit" data-live hidden><b data-unit="h">00</b><small>hrs</small></span>
        <span class="cd-unit" data-live hidden><b data-unit="m">00</b><small>min</small></span>
        <span class="cd-unit" data-live hidden><b data-unit="s">00</b><small>sec</small></span>
      </p>
      <p class="cd-now"{% if days > 0 %} hidden{% endif %}>Come find us by the fire.</p>
    </div>
    {% if d.photo and d.photoCredit %}<figcaption class="credit">{{ d.photoCredit }}</figcaption>{% endif %}
  </figure>
  <div class="wrap h-next-body">
    <div class="h-next-info">
      <p class="place">{{ d.place }}{% if d.region %} · {{ d.region }}{% endif %}</p>
      {% if d.highlights and d.highlights.length %}
      <ul class="moments" aria-label="What you'll find">
        {% for h in d.highlights %}<li>{{ h }}</li>{% endfor %}
      </ul>
      {% endif %}
      <p class="spot-line">
        {% if d.coords | latLng %}{% icon "pin" %} The spot is set. <a href="{{ next.url }}#getting-there">Get directions</a>
        {% else %}{% icon "mystery" %} Exact spot drops around {{ d | revealDate | dates }}.{% endif %}
      </p>
      <div class="actions">
        {% if d.chat %}
          <a class="btn primary" href="{{ d.chat }}">Join the chat</a>
          <a class="btn" href="{{ next.url }}">Details</a>
        {% else %}
          <a class="btn primary" href="{{ next.url }}">Details</a>
          <span class="soon">Chat opens soon</span>
        {% endif %}
      </div>
    </div>
    {% set later = collections.upcoming.slice(1, 4) %}
    {% if later.length %}
    <div class="h-later">
      <h3 class="label">Then</h3>
      <ul class="ev-list">
        {% for e in later %}{% include "event-row.njk" %}{% endfor %}
      </ul>
      <p class="more"><a href="/events/">All events <span aria-hidden="true">→</span></a></p>
    </div>
    {% endif %}
  </div>
  {% else %}
  <div class="wrap h-next-head">
    <p class="label sun">Next up</p>
    <h2>The next one is coming soon.</h2>
    <p class="lede">Follow along on <a href="{{ site.contact.instagram }}">Instagram</a> to hear first.</p>
  </div>
  {% endif %}
</section>

{% include "donate.njk" %}
