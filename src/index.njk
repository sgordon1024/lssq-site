---
layout: base.njk
---
{% set next = collections.upcoming[0] %}
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-inner">
    <div class="hero-intro">
      <p class="label">{{ site.hero.label }}</p>
      <h1 id="hero-title">{{ site.hero.headline }}</h1>
      <p class="lede">{{ site.hero.text }}</p>
      <a class="btn" href="/events/">See all events</a>
    </div>

    {% if next %}
    {% set d = next.data %}
    {% set days = d.start | daysUntil %}
    <article class="next-card echo-host" aria-labelledby="next-title">
      {# The next event's photo, with two from past weekends: what it feels like to be there. #}
      <div class="next-photos">
        <figure class="np-main">
          {% if d.photo %}<img src="{{ d.photo }}" alt="{{ d.photoAlt }}">{% endif %}
          <p class="cd-pill" data-countdown="pill" data-start="{{ d | startsAt }}" data-end="{{ d | endsAt }}">{% if days > 1 %}<b>{{ days }}</b> days to go{% elif days == 1 %}<b>Tomorrow</b>{% else %}<b>Happening now</b>{% endif %}</p>
        </figure>
        {% for g in site.gallery | head(2) %}
        <figure class="np-side"><img src="{{ g.photo }}" alt="{{ g.alt }}" loading="lazy"></figure>
        {% endfor %}
        {% if site.gallery.length %}<p class="np-tag">From past weekends</p>{% endif %}
      </div>
      <p class="label sun">Next up · {{ d.start | dates(d.end) }}{% if d.sample %} · <span class="tag">Sample</span>{% endif %}</p>
      <h2 class="echo" id="next-title" data-text="{{ d.title }}"><a href="{{ next.url }}">{{ d.title }}</a></h2>
      <p class="place">{{ d.place }}{% if d.region %} · {{ d.region }}{% endif %}</p>
      {% if d.highlights and d.highlights.length %}
      <ul class="moments" aria-label="What you'll find">
        {% for h in d.highlights %}<li>{{ h }}</li>{% endfor %}
      </ul>
      {% endif %}
      <p class="spot-line">
        {% if d.coords | latLng %}{% icon "pin" %} The spot is set. <a href="{{ next.url }}#getting-there">Get directions</a>
        {% else %}{% icon "mystery" %} Exact spot drops around {{ d | revealDate | dates }}.{% endif %}
      </p>
      <div class="actions">
        {% if d.chat %}
          <a class="btn primary" href="{{ d.chat }}">Join the chat</a>
          <a class="btn" href="{{ next.url }}">Details</a>
        {% else %}
          <a class="btn primary" href="{{ next.url }}">Details</a>
          <span class="soon">Chat opens soon</span>
        {% endif %}
      </div>
    </article>
    {% else %}
    <div class="next-card empty">
      <p class="label sun">Next up</p>
      <h2>The next one is coming soon.</h2>
      <p class="place">Follow along on <a href="{{ site.contact.instagram }}">Instagram</a> to hear first.</p>
    </div>
    {% endif %}
  </div>
</section>

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap about-inner">
    <div class="about-text">
      <p class="label">What is LSSQ</p>
      <h2 id="about-title">{{ site.about.headline }}</h2>
      <p>{{ site.about.text }}</p>
      <a class="more-link" href="/story/">Read our story <span aria-hidden="true">→</span></a>
    </div>
    <ul class="pillars">
      {% set colors = ["var(--cyan)", "var(--sun)", "var(--pink)", "var(--lav)"] %}
      {% for pillar in site.about.pillars %}
      <li style="--c: {{ colors[loop.index0 % 4] }}">
        <span class="pillar-badge">{% icon pillar.icon %}</span>
        <h3>{{ pillar.name }}</h3>
        <p>{{ pillar.text }}</p>
        {% icon pillar.icon, "pillar-mark" %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section soon-section" id="events" aria-labelledby="events-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label">Coming up</p>
      <h2 id="events-title">Save the weekend.</h2>
    </div>
    {% if collections.upcoming.length %}
    <ul class="ev-list">
      {% for e in collections.upcoming | head(4) %}{% include "event-row.njk" %}{% endfor %}
    </ul>
    <p class="more"><a href="/events/">All events <span aria-hidden="true">→</span></a></p>
    {% else %}
    <p class="empty-note">Nothing on the calendar yet. Follow along on <a href="{{ site.contact.instagram }}">Instagram</a> to hear first.</p>
    {% endif %}
  </div>
</section>

{% include "donate.njk" %}
